{
  "scope": "community",
  "name": "google-analytics",
  "version": "1.1.0",
  "description": "Commands to interact with Google Analytics (GA4) using the Analytics Data API",
  "license": "MIT",
  "tags": [
    "google",
    "analytics",
    "ga4",
    "google-analytics",
    "reporting",
    "cli"
  ],
  "dependencies": [
    "community/google-auth",
    "aux4/curl"
  ],
  "system": [
    [
      "test:jq --version",
      "brew:jq",
      "linux:jq"
    ]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "google",
          "execute": [
            "profile:google"
          ],
          "help": {
            "text": "Google commands"
          }
        }
      ]
    },
    {
      "name": "google",
      "commands": [
        {
          "name": "analytics",
          "execute": [
            "profile:google:analytics"
          ],
          "help": {
            "text": "Google Analytics (GA4) commands"
          }
        }
      ]
    },
    {
      "name": "google:analytics",
      "commands": [
        {
          "name": "services",
          "private": true,
          "execute": [
            "echo '{\"name\":\"analytics\",\"scope\":\"https://www.googleapis.com/auth/analytics.readonly\",\"readonlyScope\":\"https://www.googleapis.com/auth/analytics.readonly\",\"description\":\"Access Google Analytics data (GA4)\"}'"
          ],
          "help": {
            "text": "Output service metadata for auth resolution"
          }
        },
        {
          "name": "report",
          "execute": [
            "set:dateRangeList=!START=value(startDate) END=value(endDate) jq -cn '[{startDate: env.START, endDate: env.END}]'",
            "set:dimensionList=!DIMENSIONS=value(dimensions) jq -cn 'env.DIMENSIONS | split(\",\") | map(select(. != \"\") | {name: .})'",
            "set:metricList=!METRICS=value(metrics) jq -cn 'env.METRICS | split(\",\") | map(select(. != \"\") | {name: .})'",
            "set:requestUrl=${apiUrl}/v1beta/properties/${propertyId}:runReport",
            "aux4 curl auth-request --provider google --tokenFile param(tokenFile) --method POST --header 'Content-Type: application/json' --url value(requestUrl) --body 'object(dateRangeList:dateRanges, dimensionList:dimensions, metricList:metrics, limit)'"
          ],
          "help": {
            "text": "Run a standard GA4 report",
            "variables": [
              {
                "name": "propertyId",
                "text": "GA4 property ID (numeric, e.g. 123456789)",
                "arg": true
              },
              {
                "name": "startDate",
                "text": "Start date (YYYY-MM-DD or relative: yesterday, 7daysAgo, 30daysAgo)"
              },
              {
                "name": "endDate",
                "text": "End date (YYYY-MM-DD or relative: today, yesterday)"
              },
              {
                "name": "dimensions",
                "text": "Comma-separated dimensions (e.g. date,country,pagePath)",
                "default": "date"
              },
              {
                "name": "metrics",
                "text": "Comma-separated metrics (e.g. sessions,activeUsers,screenPageViews)",
                "default": "sessions,activeUsers"
              },
              {
                "name": "limit",
                "text": "Maximum number of rows to return",
                "default": "10000",
                "type": "number"
              },
              {
                "name": "dateRangeList",
                "text": "Date ranges as a JSON array, derived from --startDate and --endDate",
                "default": "",
                "type": "json",
                "private": true
              },
              {
                "name": "dimensionList",
                "text": "Dimensions as a JSON array, derived from --dimensions",
                "default": "",
                "type": "json",
                "private": true
              },
              {
                "name": "metricList",
                "text": "Metrics as a JSON array, derived from --metrics",
                "default": "",
                "type": "json",
                "private": true
              },
              {
                "name": "tokenFile",
                "text": "Where the Google OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Analytics Data API base URL",
                "default": "https://analyticsdata.googleapis.com",
                "env": "GOOGLE_ANALYTICS_API_URL",
                "private": true
              }
            ]
          }
        },
        {
          "name": "realtime",
          "execute": [
            "set:dimensionList=!DIMENSIONS=value(dimensions) jq -rn 'env.DIMENSIONS | split(\",\") | map(select(. != \"\") | {name: .}) | if length == 0 then \"\" else tojson end'",
            "set:metricList=!METRICS=value(metrics) jq -cn 'env.METRICS | split(\",\") | map(select(. != \"\") | {name: .})'",
            "set:requestUrl=${apiUrl}/v1beta/properties/${propertyId}:runRealtimeReport",
            "aux4 curl auth-request --provider google --tokenFile param(tokenFile) --method POST --header 'Content-Type: application/json' --url value(requestUrl) --body 'object(metricList:metrics, dimensionList:dimensions, limit)'"
          ],
          "help": {
            "text": "Run a realtime report for the last 30 minutes",
            "variables": [
              {
                "name": "propertyId",
                "text": "GA4 property ID (numeric, e.g. 123456789)",
                "arg": true
              },
              {
                "name": "metrics",
                "text": "Comma-separated metrics (e.g. activeUsers,screenPageViews)",
                "default": "activeUsers"
              },
              {
                "name": "dimensions",
                "text": "Comma-separated dimensions (e.g. country,unifiedScreenName)",
                "default": ""
              },
              {
                "name": "limit",
                "text": "Maximum number of rows to return",
                "default": "100",
                "type": "number"
              },
              {
                "name": "dimensionList",
                "text": "Dimensions as a JSON array, derived from --dimensions",
                "default": "",
                "type": "json",
                "private": true
              },
              {
                "name": "metricList",
                "text": "Metrics as a JSON array, derived from --metrics",
                "default": "",
                "type": "json",
                "private": true
              },
              {
                "name": "tokenFile",
                "text": "Where the Google OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Analytics Data API base URL",
                "default": "https://analyticsdata.googleapis.com",
                "env": "GOOGLE_ANALYTICS_API_URL",
                "private": true
              }
            ]
          }
        },
        {
          "name": "metadata",
          "execute": [
            "set:requestUrl=${apiUrl}/v1beta/properties/${propertyId}/metadata",
            "aux4 curl auth-request --provider google --tokenFile param(tokenFile) --url value(requestUrl)"
          ],
          "help": {
            "text": "List available dimensions and metrics for a property",
            "variables": [
              {
                "name": "propertyId",
                "text": "GA4 property ID (numeric, e.g. 123456789)",
                "arg": true
              },
              {
                "name": "tokenFile",
                "text": "Where the Google OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              },
              {
                "name": "apiUrl",
                "text": "Analytics Data API base URL",
                "default": "https://analyticsdata.googleapis.com",
                "env": "GOOGLE_ANALYTICS_API_URL",
                "private": true
              }
            ]
          }
        }
      ]
    }
  ]
}
